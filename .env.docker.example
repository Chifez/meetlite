# ==========================================
# MeetLite Docker Compose Environment Template
# Copy this file to .env before running `docker compose up`
# ==========================================

# Database & Cache Credentials
POSTGRES_USER=meetlite
POSTGRES_PASSWORD=meetlite_secure_password_2026
POSTGRES_DB=meetlite

# Authentication Secrets (generate random strings in production)
JWT_SECRET=super_secret_jwt_key_for_meetlite_production_2026
SESSION_SECRET=super_secret_session_key_for_meetlite_production_2026
INITIAL_SYSTEM_ADMIN_EMAIL=admin@meetlite.dev
INITIAL_SYSTEM_ADMIN_PASSWORD=admin123

# WebRTC Networking
# For local Docker Desktop on Mac/Windows: 127.0.0.1
# For cloud VM / VPS deployment: Set to your public IP (e.g. 198.51.100.1)
ANNOUNCED_IP=127.0.0.1

# Cloudflare R2 Storage (For video recordings & assets)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=meetlite-recordings

# Third-party Integrations (Optional for local test)
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
