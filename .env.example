# ==========================================
# MeetLite Docker Compose Environment Template
# Copy this file to .env before running `docker compose up`
# ==========================================

# Database & Cache Credentials
POSTGRES_USER=meetlite
POSTGRES_PASSWORD=replace_with_strong_database_password_minimum_32_chars
POSTGRES_DB=meetlite
# Optional overrides for Neon / Remote Managed PostgreSQL:
# DATABASE_URL: Pooled endpoint for application queries (e.g. postgresql://user:pass@ep-xyz-pooler.neon.tech/meetlite?pgbouncer=true&connection_limit=10)
# DIRECT_URL: Direct endpoint reserved for migrations (e.g. postgresql://user:pass@ep-xyz.neon.tech/meetlite)

# Authentication Secrets (generate random strings of >= 32 characters in production)
# Example generator: openssl rand -base64 32
JWT_SECRET=replace_with_strong_jwt_secret_minimum_32_characters
SESSION_SECRET=replace_with_strong_session_secret_minimum_32_char
# Ed25519 PKCS#8 private key used only by room-service. Store newlines as \\n.
CAPABILITY_PRIVATE_KEY=
# Matching public JWK used only by edge-room-coordinator.
CAPABILITY_PUBLIC_KEY_JWK=
CLOUDFLARE_CALLS_APP_ID=
CLOUDFLARE_CALLS_APP_SECRET=
VITE_MEDIA_ENGINE=mediasoup
INITIAL_SYSTEM_ADMIN_EMAIL=admin@meetlite.dev
INITIAL_SYSTEM_ADMIN_PASSWORD=replace_with_strong_admin_password_min_16_chars

# WebRTC Networking
# For local Docker Desktop on Mac/Windows: 127.0.0.1
# For cloud VM / VPS deployment: Set to your public IP (e.g. 198.51.100.1)
ANNOUNCED_IP=127.0.0.1

# Cloudflare R2 Storage (For video recordings & assets)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=meetlite-recordings

# Third-party Integrations (Optional for local test)
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
