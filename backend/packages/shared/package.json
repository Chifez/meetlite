{
  "name": "@minimeet/shared",
  "version": "1.0.0",
  "description": "Shared database models, utilities, and queue infrastructure for MeetLite backend services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test 'src/**/*.test.ts'",
    "test": "npm run test:unit",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema=prisma/schema.prisma",
    "prisma:migrate:resolve": "prisma migrate resolve --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@aws-sdk/s3-request-presigner": "^3.1084.0",
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.66.2",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.6",
    "prisma": "^5.20.0",
    "redis": "^5.8.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.0",
    "typescript": "^5.4.0"
  }
}
